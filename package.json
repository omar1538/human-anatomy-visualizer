{
  "name": "human-anatomy-visualizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive 3D anatomy learning platform (WebGPU only)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --config .github/eslint.config.mjs src",
    "test": "node --test \"src/scripts/tests/**/*.test.mjs\"",
    "validate": "python data_pipeline/validate_content.py --strict",
    "format": "prettier --write src/index.html src/sw.mjs src/scripts src/styles docs .github \"*.md\""
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "vite": "8.3.5"
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "printWidth": 100
  }
}
